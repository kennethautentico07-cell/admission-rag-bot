# ==========================================
# TPC-Assist Environment Configuration
# ==========================================

# Google Gemini API Key (Required for ChatGoogleGenerativeAI)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# HuggingFace Token (Optional: increases download rate limits for sentence-transformers)
# HF_TOKEN=your_huggingface_token_here

